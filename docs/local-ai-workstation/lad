#!/usr/bin/env bash
set -Eeuo pipefail
IFS=$'\n\t'

resolve_script_path() {
  local source dir target
  source="${BASH_SOURCE[0]}"
  while [[ -L "$source" ]]; do
    dir="$(cd -P -- "$(dirname -- "$source")" && pwd)"
    target="$(readlink "$source")"
    if [[ "$target" == /* ]]; then source="$target"; else source="$dir/$target"; fi
  done
  dir="$(cd -P -- "$(dirname -- "$source")" && pwd)"
  printf '%s/%s\n' "$dir" "$(basename -- "$source")"
}

SCRIPT_PATH="$(resolve_script_path)"
SCRIPT_DIR="$(cd -P -- "$(dirname -- "$SCRIPT_PATH")" && pwd)"
HARNESS_ASSET_DIR="$SCRIPT_DIR"

if [[ -n "${LAD_REPO_ROOT:-}" ]]; then
  REPO_ROOT="$(git -C "$LAD_REPO_ROOT" rev-parse --show-toplevel 2>/dev/null)" || { echo "[lad] ERROR: LAD_REPO_ROOT is not inside a git repository: $LAD_REPO_ROOT" >&2; exit 1; }
else
  REPO_ROOT="$(git -C "$PWD" rev-parse --show-toplevel 2>/dev/null)" || { echo "[lad] ERROR: current directory is not inside a git repository. Set LAD_REPO_ROOT to override." >&2; exit 1; }
fi

TARGET_HARNESS_DIR="$REPO_ROOT/docs/local-ai-workstation"
if [[ -d "$TARGET_HARNESS_DIR" ]]; then
  STATE_DIR="${LAD_STATE_DIR:-$TARGET_HARNESS_DIR/.lad}"
  SESSIONS_DIR="${LAD_SESSIONS_DIR:-$TARGET_HARNESS_DIR/sessions}"
  RESULTS_DIR="${LAD_RESULTS_DIR:-$TARGET_HARNESS_DIR/results/lad}"
else
  GIT_COMMON_DIR="$(git -C "$REPO_ROOT" rev-parse --git-common-dir)"
  if [[ "$GIT_COMMON_DIR" != /* ]]; then GIT_COMMON_DIR="$REPO_ROOT/$GIT_COMMON_DIR"; fi
  STATE_DIR="${LAD_STATE_DIR:-$GIT_COMMON_DIR/lad/state}"
  SESSIONS_DIR="${LAD_SESSIONS_DIR:-$GIT_COMMON_DIR/lad/sessions}"
  RESULTS_DIR="${LAD_RESULTS_DIR:-$GIT_COMMON_DIR/lad/results}"
fi
MODEL_OPENCODE="ollama/qwen3.6:35b-a3b-nvfp4"
MODEL_OLLAMA="qwen3.6:35b-a3b-nvfp4"
ACTIVE_FILE="$STATE_DIR/active-session"
PREPARED_INTENT_FILES=()

usage() {
  cat <<'USAGE'
Usage: lad <command> [args]

Local Agentic Dev harness for one production path only:
OpenCode + Ollama + qwen3.6:35b-a3b-nvfp4.
The target repository is never mutated by start, ask, test, shell, diff, status,
or checkpoint. Only `lad apply` writes a session patch back to the real repo.

Commands:
  help            Show this help.
  doctor          Check git, bash, OpenCode, Ollama, model, and repo state.
  start [name]    Create/resume an isolated snapshot sandbox from current HEAD.
  ask TEXT        Run OpenCode in the active session, capture logs, then checks.
  shell           Open interactive OpenCode in the active session sandbox.
  test            Run available just/package lint, test, and build checks.
  diff            Show active session diff against its base commit.
  status          Show active session metadata and git status.
  checkpoint      Save session patch, status, and check logs under results/lad/.
  apply           Apply session diff to the real repo with git apply --3way.
  stop [--force]  Remove the active session; refuses uncheckpointed diff unless forced.
  bench           Run benchmark-agent.sh for OpenCode/Qwen only.
  offline-check   Validate local offline readiness and fallback-free config.
  uninstall       Remove LAD state/sessions only; optional --include-results.

Environment:
  LAD_ALLOW_DIRTY=1   Allow `lad apply` when the real repo has unrelated changes.
  LAD_REPO_ROOT=path  Override target git repo; defaults to current directory repo.
  LAD_SESSION=name    Select a session without changing the active pointer.
USAGE
}

log() { printf '[lad] %s\n' "$*"; }
warn() { printf '[lad] WARN: %s\n' "$*" >&2; }
fail() { printf '[lad] ERROR: %s\n' "$*" >&2; exit 1; }
have() { command -v "$1" >/dev/null 2>&1; }
now_utc() { date -u +%Y%m%dT%H%M%SZ; }

ensure_dirs() { mkdir -p "$STATE_DIR" "$SESSIONS_DIR" "$RESULTS_DIR" "$RESULTS_DIR/logs" "$RESULTS_DIR/checkpoints" "$RESULTS_DIR/checks"; }

active_name() {
  if [[ -n "${LAD_SESSION:-}" ]]; then
    printf '%s\n' "$LAD_SESSION"
  elif [[ -f "$ACTIVE_FILE" ]]; then
    cat "$ACTIVE_FILE"
  else
    return 1
  fi
}

session_dir() { printf '%s/%s\n' "$SESSIONS_DIR" "$1"; }
metadata_file() { printf '%s/%s.env\n' "$STATE_DIR" "$1"; }
last_checkpoint_file() { printf '%s/%s.last-checkpoint-sha\n' "$STATE_DIR" "$1"; }

load_session() {
  local name="${1:-}"
  if [[ -z "$name" ]]; then name="$(active_name)" || fail "No active session. Run: lad start"; fi
  local meta; meta="$(metadata_file "$name")"
  [[ -f "$meta" ]] || fail "Session metadata not found: $meta"
  # shellcheck disable=SC1090
  source "$meta"
  SESSION_NAME="$name"
  SESSION_DIR="$(session_dir "$name")"
  [[ -d "$SESSION_DIR" ]] || fail "Session sandbox not found: $SESSION_DIR"
}

sanitize_name() {
  local raw="${1:-lad-$(now_utc)}" sanitized
  sanitized="$(printf '%s\n' "$raw" | tr -cs 'A-Za-z0-9._-' '-' | sed 's/^-//; s/-$//')"
  [[ -n "$sanitized" ]] || sanitized="lad-$(now_utc)"
  printf '%s\n' "$sanitized"
}

write_metadata() {
  local name="$1" base_branch="$2" source_commit="$3" session_base_commit="$4" dir="$5" created="$6"
  cat > "$(metadata_file "$name")" <<META
SESSION_NAME='$name'
BASE_BRANCH='$base_branch'
SOURCE_COMMIT='$source_commit'
BASE_COMMIT='$session_base_commit'
SESSION_DIR='$dir'
CREATED_AT='$created'
MODEL_OPENCODE='$MODEL_OPENCODE'
MODEL_OLLAMA='$MODEL_OLLAMA'
META
}
setup_session_home() {
  local dir="$1"
  mkdir -p "$dir/.lad-home/.config/opencode" "$dir/.lad-home/.cache" "$dir/.lad-home/.local/state" "$dir/.lad-home/.local/share"
  if [[ -f "$HOME/.config/opencode/opencode.json" && ! -f "$dir/.lad-home/.config/opencode/opencode.json" ]]; then
    cp "$HOME/.config/opencode/opencode.json" "$dir/.lad-home/.config/opencode/opencode.json"
  fi
}

write_session_excludes() {
  local dir="$1" exclude_file
  exclude_file="$(git -C "$dir" rev-parse --git-path info/exclude)"
  mkdir -p "$(dirname "$exclude_file")"
  grep -qxF '.lad-home/' "$exclude_file" 2>/dev/null || echo '.lad-home/' >> "$exclude_file"
  grep -qxF 'README.lad.md' "$exclude_file" 2>/dev/null || echo 'README.lad.md' >> "$exclude_file"
}

with_session_env() {
  local dir="$1"; shift
  HOME="$dir/.lad-home" \
  XDG_CONFIG_HOME="$dir/.lad-home/.config" \
  XDG_CACHE_HOME="$dir/.lad-home/.cache" \
  XDG_STATE_HOME="$dir/.lad-home/.local/state" \
  XDG_DATA_HOME="$dir/.lad-home/.local/share" \
  "$@"
}

cmd_doctor() {
  local ok=0
  log "asset dir: $HARNESS_ASSET_DIR"
  log "target repo: $REPO_ROOT"
  log "state: $STATE_DIR"
  log "sessions: $SESSIONS_DIR"
  log "results: $RESULTS_DIR"
  for bin in git bash opencode ollama; do
    if have "$bin"; then log "$bin: $(command -v "$bin")"; else warn "$bin not found"; ok=1; fi
  done
  if have ollama; then
    if ollama list 2>/dev/null | awk '{print $1}' | grep -Fxq "$MODEL_OLLAMA"; then
      log "model present: $MODEL_OLLAMA"
    else
      warn "model not found in ollama list: $MODEL_OLLAMA"; ok=1
    fi
    if ollama ps >/dev/null 2>&1; then log "ollama API: reachable"; else warn "ollama API not reachable"; ok=1; fi
  fi
  if [[ -f "$HOME/.config/opencode/opencode.json" ]]; then
    log "OpenCode config source: present"
  else
    warn "OpenCode config source not found at ~/.config/opencode/opencode.json"
  fi
  return "$ok"
}

copy_repo_snapshot() {
  local dest="$1"
  mkdir -p "$dest"
  if have rsync; then
    rsync -a \
      --exclude '.git/' \
      --exclude 'docs/local-ai-workstation/.lad/' \
      --exclude 'docs/local-ai-workstation/sessions/' \
      --exclude 'docs/local-ai-workstation/results/lad/' \
      "$REPO_ROOT/" "$dest/"
  else
    (cd "$REPO_ROOT" && tar \
      --exclude './.git' \
      --exclude './docs/local-ai-workstation/.lad' \
      --exclude './docs/local-ai-workstation/sessions' \
      --exclude './docs/local-ai-workstation/results/lad' \
      -cf - .) | (cd "$dest" && tar -xf -)
  fi
}

cmd_start() {
  ensure_dirs
  local name dir meta branch source_commit created session_base_commit
  name="$(sanitize_name "${1:-}")"
  dir="$(session_dir "$name")"
  meta="$(metadata_file "$name")"
  branch="$(git -C "$REPO_ROOT" branch --show-current)"
  [[ -n "$branch" ]] || branch="detached"
  source_commit="$(git -C "$REPO_ROOT" rev-parse HEAD)"
  created="$(now_utc)"

  if [[ -d "$dir" && -f "$meta" ]]; then
    log "resuming session: $name"
  else
    [[ ! -e "$dir" ]] || fail "Session path exists without metadata: $dir"
    copy_repo_snapshot "$dir"
    git -C "$dir" init -q
    git -C "$dir" add .
    git -C "$dir" -c user.name='LAD' -c user.email='lad@local.invalid' commit -qm "lad session base snapshot"
    session_base_commit="$(git -C "$dir" rev-parse HEAD)"
    write_session_excludes "$dir"
    setup_session_home "$dir"
    write_metadata "$name" "$branch" "$source_commit" "$session_base_commit" "$dir" "$created"
    cat > "$dir/README.lad.md" <<README
# LAD Session: $name

Created: $created UTC
Base branch: $branch
Source commit: $source_commit
Session base commit: $session_base_commit
Agent: OpenCode
Model: $MODEL_OPENCODE

This is an isolated snapshot sandbox. Inspect with \`lad diff\`, checkpoint with \`lad checkpoint\`, and apply to the real repo only with \`lad apply\`.
README
  fi
  printf '%s\n' "$name" > "$ACTIVE_FILE"
  log "active session: $name"
  log "sandbox: $dir"
}
run_checks() {
  local dir="$1"
  (cd "$dir" && cmd_test_impl)
}

cmd_ask() {
  load_session ""
  [[ $# -gt 0 ]] || fail "Usage: lad ask TEXT"
  have opencode || fail "opencode not found on PATH"
  ensure_dirs
  setup_session_home "$SESSION_DIR"
  local stamp log_file prompt
  stamp="$(now_utc)"
  log_file="$RESULTS_DIR/logs/$SESSION_NAME-$stamp-opencode.log"
  prompt="$*"
  log "running OpenCode in $SESSION_DIR"
  local opencode_rc=0
  (
    cd "$SESSION_DIR"
    with_session_env "$SESSION_DIR" opencode run --model "$MODEL_OPENCODE" "$prompt"
  ) 2>&1 | tee "$log_file" || opencode_rc="$?"
  log "log: $log_file"
  local checks_rc=0
  run_checks "$SESSION_DIR" || checks_rc="$?"
  if [[ "$opencode_rc" -ne 0 ]]; then return "$opencode_rc"; fi
  return "$checks_rc"
}

cmd_shell() {
  load_session ""
  have opencode || fail "opencode not found on PATH"
  setup_session_home "$SESSION_DIR"
  log "opening OpenCode shell in $SESSION_DIR"
  if (cd "$SESSION_DIR" && with_session_env "$SESSION_DIR" opencode --model "$MODEL_OPENCODE"); then
    return 0
  fi
  warn "OpenCode rejected or failed with direct --model invocation."
  printf 'Manual command:\n  cd %q && opencode --model %q\n' "$SESSION_DIR" "$MODEL_OPENCODE"
}

package_manager() {
  if [[ -f pnpm-lock.yaml ]] && have pnpm; then echo pnpm
  elif [[ -f yarn.lock ]] && have yarn; then echo yarn
  elif [[ -f package-lock.json ]] && have npm; then echo npm
  elif [[ -f package.json ]] && have npm; then echo npm
  else echo ""
  fi
}

has_npm_script() {
  local script="$1"
  have node || return 1
  node -e "const p=require('./package.json'); process.exit(p.scripts && p.scripts[process.argv[1]] ? 0 : 1)" "$script" >/dev/null 2>&1
}

run_pkg_script() {
  local pm="$1" script="$2"
  case "$pm" in
    pnpm) pnpm run "$script" ;;
    yarn) yarn run "$script" ;;
    npm) npm run "$script" ;;
    *) return 1 ;;
  esac
}

just_has_recipe() {
  local recipe="$1"
  just --summary 2>/dev/null | tr ' ' '\n' | grep -Eq "^${recipe}$"
}

cmd_test_impl() {
  local ran=0 stamp check_log
  ensure_dirs
  stamp="$(now_utc)"
  check_log="$RESULTS_DIR/checks/${SESSION_NAME:-manual}-$stamp.txt"
  : > "$check_log"
  record_check() { printf '%s\n' "$*" | tee -a "$check_log"; }

  if [[ -f justfile || -f Justfile ]]; then
    if have just; then
      local recipe
      for recipe in lint test build; do
        if just_has_recipe "$recipe"; then record_check "run: just $recipe"; just "$recipe" 2>&1 | tee -a "$check_log"; ran=1; else record_check "skip: just $recipe recipe not present"; fi
      done
    else
      record_check "skip: justfile present but just is not installed"
    fi
  else
    record_check "skip: no justfile"
  fi

  if [[ -f package.json ]]; then
    local pm script
    pm="$(package_manager)"
    if [[ -n "$pm" ]]; then
      for script in lint test build; do
        if has_npm_script "$script"; then record_check "run: $pm run $script"; run_pkg_script "$pm" "$script" 2>&1 | tee -a "$check_log"; ran=1; else record_check "skip: package script '$script' not present"; fi
      done
    else
      record_check "skip: package.json present but no supported package manager executable found"
    fi
  else
    record_check "skip: no package.json"
  fi

  if [[ "$ran" -eq 0 ]]; then record_check "result: no lint/test/build checks found; skipped"; fi
  log "check log: $check_log"
}

cmd_test() { load_session ""; (cd "$SESSION_DIR" && cmd_test_impl); }

prepare_diff_index() {
  local dir="$1" file
  local files=()
  PREPARED_INTENT_FILES=()
  while IFS= read -r -d '' file; do
    case "$file" in README.lad.md|.lad-home|.lad-home/*) continue ;; esac
    files+=("$file")
    PREPARED_INTENT_FILES+=("$file")
  done < <(git -C "$dir" ls-files --others --exclude-standard -z)
  if [[ "${#files[@]}" -gt 0 ]]; then git -C "$dir" add -N -- "${files[@]}"; fi
}

reset_diff_index() {
  local dir="$1"
  if [[ "${#PREPARED_INTENT_FILES[@]}" -gt 0 ]]; then git -C "$dir" reset -q -- "${PREPARED_INTENT_FILES[@]}" || true; fi
  PREPARED_INTENT_FILES=()
}

session_patch_sha() {
  load_session ""
  prepare_diff_index "$SESSION_DIR"
  local sha
  # shellcheck disable=SC2153
  sha="$(git -C "$SESSION_DIR" diff --binary "$BASE_COMMIT" -- . ':(exclude)README.lad.md' ':(exclude).lad-home/**' | git hash-object --stdin)"
  reset_diff_index "$SESSION_DIR"
  printf '%s\n' "$sha"
}

cmd_diff() {
  load_session ""
  ensure_dirs
  local stamp patch_file
  stamp="$(now_utc)"
  patch_file="$RESULTS_DIR/diff-$SESSION_NAME-$stamp.patch"
  prepare_diff_index "$SESSION_DIR"
  if git -C "$SESSION_DIR" diff --binary "$BASE_COMMIT" -- . ':(exclude)README.lad.md' ':(exclude).lad-home/**' | tee "$patch_file"; then
    reset_diff_index "$SESSION_DIR"
    log "diff saved: $patch_file"
  else
    local rc="$?"; reset_diff_index "$SESSION_DIR"; return "$rc"
  fi
}

cmd_status() {
  load_session "${1:-}"
  ensure_dirs
  local stamp status_file
  stamp="$(now_utc)"
  status_file="$RESULTS_DIR/status-$SESSION_NAME-$stamp.txt"
  # shellcheck disable=SC2153
  {
    cat <<STATUS
Session: $SESSION_NAME
Sandbox: $SESSION_DIR
Base branch: $BASE_BRANCH
Source commit: ${SOURCE_COMMIT:-unknown}
Session base commit: $BASE_COMMIT
Model: $MODEL_OPENCODE
STATUS
    git -C "$SESSION_DIR" status --short --branch -- . ':(exclude)README.lad.md' ':(exclude).lad-home/**' 
  } | tee "$status_file"
  log "status saved: $status_file"
}

cmd_checkpoint() {
  load_session ""
  ensure_dirs
  prepare_diff_index "$SESSION_DIR"
  local stamp patch meta sha
  stamp="$(now_utc)"
  patch="$RESULTS_DIR/checkpoints/$SESSION_NAME-$stamp.patch"
  meta="$RESULTS_DIR/checkpoints/$SESSION_NAME-$stamp.txt"
  if git -C "$SESSION_DIR" diff --binary "$BASE_COMMIT" -- . ':(exclude)README.lad.md' ':(exclude).lad-home/**' > "$patch"; then
    reset_diff_index "$SESSION_DIR"
  else
    local rc="$?"; reset_diff_index "$SESSION_DIR"; return "$rc"
  fi
  sha="$(git hash-object "$patch")"
  {
    echo "Session: $SESSION_NAME"
    echo "Created: $stamp UTC"
    echo "Base branch: $BASE_BRANCH"
    echo "Source commit: ${SOURCE_COMMIT:-unknown}"
    echo "Session base commit: $BASE_COMMIT"
    echo "Patch: $patch"
    echo "Patch sha: $sha"
    git -C "$SESSION_DIR" status --short --branch -- . ':(exclude)README.lad.md' ':(exclude).lad-home/**' 
  } > "$meta"
  ln -sf "checkpoints/$(basename "$patch")" "$RESULTS_DIR/latest.patch"
  printf '%s\n' "$sha" > "$(last_checkpoint_file "$SESSION_NAME")"
  log "checkpoint patch: $patch"
  log "checkpoint metadata: $meta"
}

path_inside_repo() { local path="$1"; [[ "$path" == "$REPO_ROOT"/* ]]; }
repo_relative_path() { local path="$1"; printf '%s\n' "${path#"$REPO_ROOT"/}"; }

real_repo_clean_or_allowed() {
  if [[ "${LAD_ALLOW_DIRTY:-0}" == "1" ]]; then return 0; fi
  local status_args=(status --porcelain --untracked-files=all -- .)
  local path rel
  for path in "$STATE_DIR" "$SESSIONS_DIR" "$RESULTS_DIR"; do
    if path_inside_repo "$path"; then
      rel="$(repo_relative_path "$path")"
      status_args+=(":(exclude)$rel" ":(exclude)$rel/**")
    fi
  done
  [[ -z "$(git -C "$REPO_ROOT" "${status_args[@]}")" ]] || fail "Real repo has unrelated dirty files. Commit/stash first or set LAD_ALLOW_DIRTY=1."
}

cmd_apply() {
  load_session ""
  real_repo_clean_or_allowed
  cmd_checkpoint
  local patch="$RESULTS_DIR/latest.patch"
  [[ -s "$patch" ]] || fail "Patch is empty; nothing to apply."
  log "patch preview: $patch"
  git -C "$REPO_ROOT" apply --stat "$patch" || true
  git -C "$REPO_ROOT" apply --3way "$patch"
  log "applied session diff to real repo; no commit was created"
}

cmd_stop() {
  load_session ""
  local force=0 current_sha last_sha empty_sha
  if [[ "${1:-}" == "--force" ]]; then force=1; elif [[ $# -gt 0 ]]; then fail "Usage: lad stop [--force]"; fi
  if [[ "$force" -ne 1 ]]; then
    current_sha="$(session_patch_sha)"
    empty_sha="$(printf '' | git hash-object --stdin)"
    last_sha=""
    if [[ -f "$(last_checkpoint_file "$SESSION_NAME")" ]]; then last_sha="$(cat "$(last_checkpoint_file "$SESSION_NAME")")"; fi
    if [[ "$current_sha" != "$empty_sha" && "$current_sha" != "$last_sha" ]]; then
      fail "Session has uncheckpointed changes. Run 'lad checkpoint' first or use 'lad stop --force'."
    fi
  fi
  rm -rf "$SESSION_DIR"
  rm -f "$(metadata_file "$SESSION_NAME")" "$(last_checkpoint_file "$SESSION_NAME")"
  if [[ -f "$ACTIVE_FILE" && "$(cat "$ACTIVE_FILE")" == "$SESSION_NAME" ]]; then rm -f "$ACTIVE_FILE"; fi
  log "removed session sandbox: $SESSION_NAME"
}

cmd_bench() {
  local arg
  for arg in "$@"; do
    case "$arg" in --model|--model=*|--agent|--agent=*) fail "bench is locked to OpenCode/Qwen; do not pass --agent or --model" ;; esac
  done
  if [[ -x "$HARNESS_ASSET_DIR/benchmark-agent.sh" ]]; then
    "$HARNESS_ASSET_DIR/benchmark-agent.sh" --agent opencode "$@"
  else
    fail "benchmark-agent.sh not found or not executable in asset dir: $HARNESS_ASSET_DIR"
  fi
}

config_has_fallback_refs() {
  local config="$1"
  [[ -f "$config" ]] || return 1
  grep -Eiq 'aider|north-mini-code|small_model|fallback' "$config"
}

cmd_offline_check() {
  local ok=0 config="$HOME/.config/opencode/opencode.json"
  cmd_doctor || ok=1
  if have ollama; then
    if ollama ps 2>/dev/null | grep -Fq "$MODEL_OLLAMA"; then log "model currently loaded: $MODEL_OLLAMA"; else warn "model is not currently loaded; first run may need local load time"; fi
  fi
  if [[ -f "$config" ]]; then
    if config_has_fallback_refs "$config"; then warn "OpenCode config contains fallback references (aider/north-mini-code/small_model/fallback): $config"; ok=1; else log "OpenCode config: no fallback references detected"; fi
  fi
  if [[ -f "$REPO_ROOT/package.json" ]]; then
    if [[ -d "$REPO_ROOT/node_modules" ]]; then log "node_modules present"; else warn "node_modules absent; package scripts may need local cache"; fi
    if [[ -d "$HOME/.npm" || -d "$HOME/Library/pnpm" || -d "$HOME/.cache/yarn" ]]; then log "package-manager cache detected"; else warn "no common package-manager cache detected"; fi
  fi
  return "$ok"
}

cmd_uninstall() {
  local include_results=0 arg
  for arg in "$@"; do
    case "$arg" in
      --include-results) include_results=1 ;;
      *) fail "Usage: lad uninstall [--include-results]" ;;
    esac
  done
  rm -rf "$SESSIONS_DIR" "$STATE_DIR"
  if [[ "$include_results" -eq 1 ]]; then rm -rf "$RESULTS_DIR"; fi
  log "removed LAD sessions and state"
  if [[ "$include_results" -eq 1 ]]; then log "removed LAD results by explicit flag"; fi
  log "Ollama, OpenCode, models, package managers, and Homebrew were not touched"
}

main() {
  local command="${1:-help}"
  if [[ $# -gt 0 ]]; then shift; fi
  case "$command" in
    help|--help|-h) usage ;;
    doctor) cmd_doctor "$@" ;;
    start) cmd_start "$@" ;;
    ask) cmd_ask "$@" ;;
    shell) cmd_shell "$@" ;;
    test) cmd_test "$@" ;;
    diff) cmd_diff "$@" ;;
    status) cmd_status "$@" ;;
    checkpoint) cmd_checkpoint "$@" ;;
    apply) cmd_apply "$@" ;;
    stop) cmd_stop "$@" ;;
    bench) cmd_bench "$@" ;;
    offline-check) cmd_offline_check "$@" ;;
    uninstall) cmd_uninstall "$@" ;;
    *) usage >&2; fail "Unknown command: $command" ;;
  esac
}

main "$@"
